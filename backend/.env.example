# ============================================================
# Budget-Famille — backend .env.example
# Copiez ce fichier vers `.env` puis adaptez les valeurs.
# (`.env` est ignoré par git ; `.env.example` est versionné.)
# ============================================================

# --- Application ---------------------------------------------
PROJECT_NAME=Budget-Famille API
# Liste JSON/CSV d'origines CORS autorisées pour le navigateur
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Clé secrète JWT — générez-en une avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Compte super-admin créé par initial_data.py
FIRST_SUPERUSER=admin@example.com
FIRST_NAME_SUPERUSER=Super
LAST_NAME_SUPERUSER=Admin
FIRST_SUPERUSER_PASSWORD=admin123

# --- Base de données MySQL ------------------------------------
# L'API utilise SQLAlchemy avec le pilote pymysql.
# MySQL doit être joignable depuis l'hôte/le conteneur.
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=budget
MYSQL_PASSWORD=budget
MYSQL_DB=budget_famille

# Optionnel : surcharge totale de l'URI SQLAlchemy.
# Par défaut elle est construite depuis les variables MYSQL_* ci-dessus :
#   mysql+pymysql://<MYSQL_USER>:<MYSQL_PASSWORD>@<MYSQL_SERVER>:<MYSQL_PORT>/<MYSQL_DB>?charset=utf8mb4
# SQLALCHEMY_DATABASE_URI=

# --- Démarrage / ports -----------------------------------------
# Port du serveur uvicorn (utilisé par prestart.py en direct)
PORT=8083
# Mapping de ports utilisé par docker-compose
HOST_PORT=8083
CONTAINER_PORT=8083
# ENVIRONMENT=development ajoute --reload à uvicorn (docker-compose le force)

# Si TESTING=1, prestart.py exécute pytest avant de démarrer.
TESTING=0
